<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Игра про зомби и Олега</title>
    <style>
        body { background: #0d0f12; color: #ffffff; font-family: sans-serif; text-align: center; padding-top: 50px; }
        .box { width: 450px; background: #14191f; border: 2px solid #ff3e3e; padding: 20px; margin: 0 auto; border-radius: 8px; }
        .btn { background: #00ffcc; border: none; padding: 12px 24px; cursor: pointer; font-weight: bold; margin: 10px; border-radius: 4px; }
    </style>
</head>
<body>
<div class="box">
    <h2 id="title">Окно квартиры</h2>
    <p id="story">Вы смотрите в окно: на улице зомби! Пора бежать.</p>
    <div id="choices"><button class="btn" onclick="stairs()">Выйти на лестницу</button></div>
</div>

<script>
    let kills = 0;
    let time = 5;
    const txt = document.getElementById('story');
    const ch = document.getElementById('choices'); 
    const tt = document.getElementById('title');

    function stairs() {
        tt.textContent = "Темная лестница";
        txt.textContent = "Вы спускаетесь по лестнице прямо на улицу.";
        ch.innerHTML = '<button class="btn" onclick="loop()">Выйти на улицу</button>';
    }

    function loop() {
        if (time <= 0) {
            lab();
        } else {
            tt.textContent = "Уличный прорыв (" + time + " мин осталось)";
            txt.textContent = "Вы бежите и отбиваетесь от зомби! Всего убито: " + kills;
            ch.innerHTML = '<button class="btn" onclick="kills += 2; time--; loop();">Стрелять в зомби</button>' +
                           '<button class="btn" onclick="time--; loop();">Просто бежать</button>';
        }
    }

    function lab() {
        tt.textContent = "Многоэтажка (5 этаж)";
        txt.textContent = "Вы нашли многоэтажку с надписью ЛАБОРАТОРИЯ. Поднялись на 5 этаж, сделали противоядие и залили его на GitHub!";
        ch.innerHTML = '<button class="btn" onclick="end()">Спустя 2 дня...</button>';
    }

    function end() {
        tt.textContent = "Финал истории";
        txt.textContent = "Вы обновляете свой GitHub — там 0 звезд. Открыв новости, вы узнаете, что бомж Олег уже всех вылечил своей слюной еще 2 дня назад! Вы рисковали жизнью зря.";
        ch.innerHTML = '<button class="btn" onclick="location.reload()">Играть заново</button>';
    }
</script>
</body>
</html>
